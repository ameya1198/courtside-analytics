# Copy to ~/.dbt/profiles.yml (local) or generate it in CI from GitHub Secrets.
# Use the Supabase session pooler host, not the direct connection.
courtside:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('SUPABASE_DB_HOST') }}"
      port: "{{ env_var('SUPABASE_DB_PORT', 5432) | int }}"
      user: "{{ env_var('SUPABASE_DB_USER') }}"
      password: "{{ env_var('SUPABASE_DB_PASSWORD') }}"
      dbname: "{{ env_var('SUPABASE_DB_NAME', 'postgres') }}"
      schema: staging
      threads: 4
      keepalives_idle: 0
