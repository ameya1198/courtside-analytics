# Copy to .env and fill in. Never commit .env.
# Supabase > Project Settings > Database > Connection string > Session pooler
SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=your-database-password

# Seasons to backfill, NBA season-start year (2015 = 2015-16)
BACKFILL_START_SEASON=2015

# Shot data is large, so we keep fewer seasons (2024 means the 2024-25 season onward)
SHOTS_START_SEASON=2024
SALARY_START_SEASON=2023
