# Read-only Postgres connection for the dashboard (Supabase transaction pooler, port 6543).
# Copy the exact host from Supabase > Connect > Transaction pooler. User name: courtside_reader.<project_ref>.
# Put the password in .env.local only, never commit it.
DATABASE_URL=postgresql://courtside_reader.grsrbeczbqtanyamykuf:YOUR_PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Set to "demo" to render from the bundled snapshot in data/demo instead of the database.
# DATA_MODE=demo
